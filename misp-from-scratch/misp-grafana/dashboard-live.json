  "panels": [
    {
      "id": 1,
      "title": "Scope and meaning",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**SYNTHETIC TRAINING DATA** \u2014 `livestream-demo` events visible to this MISP API key. Whole UTC event dates within the selected range. Page 1 only, maximum 100 events; verify page 2 is empty. Counts represent current records, including context attributes. Most recent modification is an event timestamp; it does not measure ingestion or platform health."
      }
    },
    {
      "id": 2,
      "title": "Visible demo events",
      "type": "stat",
      "description": "Current visible records for the demo tag and selected whole UTC event dates. Page 1, up to 100 events.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_MISP}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_MISP}"
          },
          "type": "json",
          "source": "url",
          "parser": "jq-backend",
          "format": "table",
          "url": "/events/restSearch",
          "root_selector": "def events:\n  (if type == \"array\" then .\n   elif (.response | type) == \"array\" then .response\n   else error(\"Expected MISP event array or response array\") end)\n  | .[] | (.Event // .);\ndef truth: . == true or . == 1 or . == \"1\";\ndef attrs: ((.Attribute // []) + [.Object[]?.Attribute[]?])\n  | unique_by(.uuid // .id // ([.type, .value] | join(\"|\"))) | .[];\n[events] | {events: length}",
          "columns": [
            {
              "selector": "events",
              "text": "events",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"returnFormat\": \"json\", \"tags\": \"livestream-demo\", \"limit\": 100, \"page\": 1, \"withAttachments\": false, \"metadata\": false, \"date\": [\"${__timeFrom:date:YYYY-MM-DD}\", \"${__timeTo:date:YYYY-MM-DD}\"]}",
            "headers": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
