# terraform.tfvars.example
# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.

region          = "eu-west-1"
cluster_name    = "misp-prod"
cluster_version = "1.32"

# DNS + TLS — issue the ACM cert and validate it OFF-AIR (validation is slow).
# If your domain is on Cloudflare, use a SINGLE-LEVEL hostname (e.g. the
# misp-lab.example.com shown here, or misp.example.com) — NOT a nested one like
# misp.lab.example.com. Cloudflare's free Universal SSL edge cert only covers
# example.com + *.example.com (one wildcard level), so a two-level hostname has
# no matching edge cert and fails the TLS handshake before traffic reaches AWS
# at all. See docs/dns-cutover-cloudflare.md.
misp_hostname       = "misp-lab.kravensecurity.com"
acm_certificate_arn = "arn:aws:acm:eu-west-2:111122223333:certificate/REPLACE-ME"

# Sizing (lab defaults; bump for production). Right-sized for a livestream demo
# that's destroyed between sessions (see README Cost warning / `make down`) —
# not meant to carry production headroom.
node_instance_types = ["m5.large"]
node_desired        = 2
node_min            = 1  # no pod anti-affinity/topology spread in k8s/, safe to float to 1
node_max            = 3  # caps burst cost; steady state is unaffected

db_instance_class    = "db.t3.small"
db_multi_az          = false
db_allocated_storage = 20             # storage can only grow later, not shrink
redis_node_type      = "cache.t3.small"
